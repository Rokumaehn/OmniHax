<Window x:Class="OmniHax.HitDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniHax"
        mc:Ignorable="d"
        Title="Hit Registers" Height="620" Width="820"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="RegRowTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SelectableText}" Foreground="#555" Text="{Binding Name}" />
                <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="HeaderText" Grid.Row="0" Style="{StaticResource SelectableText}"
                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="XMM view:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="XmmViewCombo" Width="130" VerticalAlignment="Center"
                      SelectionChanged="XmmView_Changed">
                <ComboBoxItem Content="Float (4 x single)" IsSelected="True" />
                <ComboBoxItem Content="Double (2 x)" />
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="General purpose" FontWeight="Bold" Margin="0,4,0,2" />
                <ItemsControl x:Name="GprList" ItemTemplate="{StaticResource RegRowTemplate}" />

                <TextBlock Text="Flags" FontWeight="Bold" Margin="0,10,0,2" />
                <TextBox x:Name="FlagsText" Style="{StaticResource SelectableText}"
                         TextWrapping="Wrap" AcceptsReturn="True" />

                <TextBlock Text="Segments" FontWeight="Bold" Margin="0,10,0,2" />
                <ItemsControl x:Name="SegmentList" ItemTemplate="{StaticResource RegRowTemplate}" />

                <TextBlock Text="Debug registers" FontWeight="Bold" Margin="0,10,0,2" />
                <ItemsControl x:Name="DebugList" ItemTemplate="{StaticResource RegRowTemplate}" />

                <TextBlock Text="x87 (ST0-ST7)" FontWeight="Bold" Margin="0,10,0,2" />
                <ItemsControl x:Name="X87List" ItemTemplate="{StaticResource RegRowTemplate}" />

                <TextBlock Text="SSE (XMM)" FontWeight="Bold" Margin="0,10,0,2" />
                <DataGrid x:Name="XmmGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Extended"
                          SelectionUnit="CellOrRowHeader"
                          RowHeaderWidth="0"
                          FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Padding="0,4"
                    IsCancel="True" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Copy all" Width="90" Padding="0,4"
                    Margin="0,0,8,0" Click="Copy_Click" />
        </DockPanel>
    </Grid>
</Window>
