<Window x:Class="OmniHax.AccessTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniHax"
        mc:Ignorable="d"
        Title="Access Tracking" Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />

        <DataGrid x:Name="HitsGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  RowDetailsVisibilityMode="Visible"
                  MouseDoubleClick="HitsGrid_MouseDoubleClick"
                  PreviewMouseRightButtonDown="HitsGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Register" Click="RegisterHit_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="26,2,4,6"
                                  MaxHeight="220"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <DataGrid ItemsSource="{Binding Records}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Disabled"
                                  RowHeaderWidth="0"
                                  MouseDoubleClick="RecordsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Width="160" Binding="{Binding TimestampText}" />
                                <DataGridTextColumn Header="Value" Width="520" Binding="{Binding ValueDisplay}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Width="22" Height="18"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Focusable="False"
                                          PreviewMouseLeftButtonDown="HitToggle_PreviewMouseLeftButtonDown"
                                          ToolTip="Show each hit">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="+" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="-" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Address" Width="150" Binding="{Binding AddressText}" />
                <DataGridTextColumn Header="Eff. address" Width="150" Binding="{Binding EffectiveAddressText}" />
                <DataGridTextColumn Header="Access" Width="90" Binding="{Binding KindText}" />
                <DataGridTextColumn Header="Thread" Width="80" Binding="{Binding ThreadId}" />
                <DataGridTextColumn Header="Hits" Width="60" Binding="{Binding Count}" />
                <DataGridTextColumn Header="Instruction" Width="*" Binding="{Binding Disassembly}" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander x:Name="DiagnosticsExpander" Grid.Row="2" Header="Diagnostics"
                  Margin="0,8,0,0" IsExpanded="False">
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="6,0,0,0">
                    <Button Content="Copy" Width="70" Padding="0,4" Click="CopyLog_Click" />
                    <Button Content="Save..." Width="70" Padding="0,4" Margin="0,4,0,0" Click="SaveLog_Click" />
                </StackPanel>
                <TextBox x:Name="DiagnosticsBox" Height="150"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Expander>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="Watch size:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="WatchSizeCombo" Width="64" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="Auto-stop after" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="AutoStopBox" Width="44" VerticalAlignment="Center" TextAlignment="Right" />
            <TextBlock Text="writers" VerticalAlignment="Center" Margin="6,0,12,0" />
            <Button x:Name="StopButton" Content="Stop Tracking" Padding="12,4" Click="StopButton_Click" />
            <Button x:Name="ClearButton" Content="Clear" Padding="12,4" Margin="8,0,0,0" Click="ClearButton_Click" />
            <Button Content="Close" Width="90" Padding="0,4" Margin="8,0,0,0" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
