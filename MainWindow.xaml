<Window x:Class="OmniHax.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniHax"
        mc:Ignorable="d"
        Title="Omni Hax" Height="560" Width="840"
        Icon="pack://application:,,,/OmniHax;component/icon.png"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0,0,0,8" Background="Transparent">
            <MenuItem Header="_File" Background="Transparent">
                <MenuItem Header="Open Process..." Click="OpenProcessMenuItem_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="Access type">
                    <MenuItem x:Name="AccessTypeHw" Header="Hardware breakpoints (debugger)"
                              IsCheckable="True" Click="AccessType_Click" />
                    <MenuItem x:Name="AccessTypeGuard" Header="Page-guard (debugger)"
                              IsCheckable="True" Click="AccessType_Click" />
                    <MenuItem x:Name="AccessTypeVeh" Header="In-process VEH (no debugger)"
                              IsCheckable="True" Click="AccessType_Click" />
                </MenuItem>
                <MenuItem Header="Scan threads">
                    <MenuItem x:Name="ThreadsAuto" Header="Auto" IsCheckable="True" Click="ScanThreads_Click" />
                    <Separator />
                    <MenuItem x:Name="Threads1" Header="1" IsCheckable="True" Click="ScanThreads_Click" />
                    <MenuItem x:Name="Threads2" Header="2" IsCheckable="True" Click="ScanThreads_Click" />
                    <MenuItem x:Name="Threads4" Header="4" IsCheckable="True" Click="ScanThreads_Click" />
                    <MenuItem x:Name="Threads8" Header="8" IsCheckable="True" Click="ScanThreads_Click" />
                    <MenuItem x:Name="Threads16" Header="16" IsCheckable="True" Click="ScanThreads_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Windows">
                <MenuItem Header="Code browser..." Click="CodeBrowserMenuItem_Click" />
                <MenuItem Header="Structure browser..." Click="StructureBrowserMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Diagnostics">
                <MenuItem Header="Attach only (no breakpoints)" Click="ProbeAttachOnly_Click" />
                <Separator />
                <MenuItem Header="External hardware breakpoint (no debugger)" Click="ProbeExternalDr_Click" />
                <MenuItem Header="External page-guard (no debugger)" Click="ProbeExternalGuard_Click" />
                <Separator />
                <MenuItem Header="Decoy baseline (allocated page)" Click="ProbeDecoyBaseline_Click" />
                <MenuItem Header="Decoy page-guard (allocated page)" Click="ProbeDecoyGuard_Click" />
                <MenuItem Header="Decoy hardware breakpoint (allocated page)" Click="ProbeDecoyDr_Click" />
            </MenuItem>
        </Menu>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="OpenProcessButton" DockPanel.Dock="Left"
                    Content="Open Process..." Padding="12,4" Click="OpenProcessButton_Click" />
            <Button x:Name="ResetButton" DockPanel.Dock="Right"
                    Content="Reset Search" Padding="12,4" Click="ResetButton_Click" />
            <TextBlock x:Name="ProcessLabel" Margin="12,0,12,0"
                       VerticalAlignment="Center" Text="No process opened." />
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="TypeCombo" Width="170" VerticalAlignment="Center" />

                <TextBlock Text="Value:" VerticalAlignment="Center" Margin="14,0,6,0" />
                <TextBox x:Name="SearchBox" Width="140" VerticalAlignment="Center"
                         KeyDown="SearchBox_KeyDown" />

                <Button x:Name="SearchButton" Content="Search" Padding="16,4" Margin="8,0,0,0"
                        Click="SearchButton_Click" />

                <Button x:Name="LessButton" Content="&lt;" Width="30" Padding="0,4" Margin="8,0,0,0"
                        VerticalAlignment="Center" IsEnabled="False"
                        ToolTip="Unknown-value scan: keep addresses whose value decreased"
                        Click="LessButton_Click" />
                <Button x:Name="GreaterButton" Content="&gt;" Width="30" Padding="0,4" Margin="4,0,0,0"
                        VerticalAlignment="Center" IsEnabled="False"
                        ToolTip="Unknown-value scan: keep addresses whose value increased"
                        Click="GreaterButton_Click" />
                <Button x:Name="EqualButton" Content="=" Width="30" Padding="0,4" Margin="4,0,0,0"
                        VerticalAlignment="Center" IsEnabled="False"
                        ToolTip="Unknown-value scan: keep addresses whose value is unchanged"
                        Click="EqualButton_Click" />

                <ProgressBar x:Name="ScanProgress" Width="130" Height="16" Margin="14,0,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="WritableOnlyCheck" Content="Writable only" IsChecked="True"
                          VerticalAlignment="Center" />
                <CheckBox x:Name="AlignedCheck" Content="Size-aligned" IsChecked="True"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,0,0,8"
                   TextWrapping="Wrap" Text="Open a process to begin." />

        <TabControl Grid.Row="4">
            <TabItem Header="Results">
                <DataGrid x:Name="ResultsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Register" Click="RegisterResult_Click" />
                            <Separator />
                            <MenuItem Header="Browse memory here" Click="BrowseMemory_Click" />
                            <Separator />
                            <MenuItem Header="Find out what writes to this address" Click="FindWrites_Click" />
                            <MenuItem Header="Find out what accesses this address" Click="FindAccesses_Click" />
                            <MenuItem Header="Find out what executes this address" Click="FindExecutes_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Width="200" IsReadOnly="True"
                                            Binding="{Binding Address}" />
                        <DataGridTextColumn Header="Value" Width="*"
                                            Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="CodesTab" Header="Codes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Freeze interval (ms):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="IntervalBox" Width="70" Text="500" VerticalAlignment="Center"
                                 TextAlignment="Right" TextChanged="IntervalBox_TextChanged" />
                        <Button x:Name="RemoveCodeButton" Content="Remove" Padding="12,4" Margin="12,0,0,0"
                                Click="RemoveCodeButton_Click" />
                    </StackPanel>

                    <DataGrid x:Name="CodesGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              BeginningEdit="CodesGrid_BeginningEdit"
                              MouseDoubleClick="CodesGrid_MouseDoubleClick"
                              PreviewKeyDown="CodesGrid_PreviewKeyDown"
                              PreviewMouseRightButtonDown="CodesGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit script..." Click="EditScript_Click" />
                                <Separator />
                                <MenuItem Header="Remove" Click="RemoveCodeButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enabled" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Description" Width="200"
                                                Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <DataGridTemplateColumn Header="Datatype" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataTypeOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Type"
                                                  SelectedValue="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Address" Width="160"
                                                Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <DataGridTextColumn x:Name="CodeValueColumn" Header="Value" Width="*"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
